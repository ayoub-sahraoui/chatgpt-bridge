{
  "name": "chatgpt-bridge",
  "version": "0.1.0",
  "description": "Browser extension that exposes the ChatGPT web UI as a local API: send messages, upload files, stream and parse responses.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build && wxt build --mode development",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "typecheck": "npm run compile",
    "sdk:build": "tsc -p sdk/tsconfig.json",
    "demo": "tsx examples/demo-agent.ts",
    "server": "tsx examples/server.ts",
    "mock": "tsx examples/mock-extension.ts",
    "register:host": "tsx scripts/register-native-host.ts",
    "postinstall": "wxt prepare && npm run sdk:build && npm run register:host"
  },
  "dependencies": {
    "@chatgpt-bridge/local-sdk": "file:sdk",
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@wxt-dev/module-react": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
